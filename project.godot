config_version=5

[application]
config/name="FX Crossroads • Network Alpha"
run/main_scene="res://network/client.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[autoload]
FXActivity="*res://scripts/activity_analytics.gd"
FXStudioPartner="*res://scripts/studio_partner.gd"
FXEducationRoom="*res://scripts/education_room.gd"
FXEducationTools="*res://scripts/education_tools.gd"
FXResearch="*res://scripts/research_session.gd"
FXClassroom="*res://scripts/classroom_broadcast.gd"
FXDevSession="*res://scripts/dev_session.gd"
FXStability="*res://scripts/stability.gd"

[debug]
file_logging/enable_file_logging=true
file_logging/max_log_files=3
file_logging/log_path="user://logs/godot.log"
