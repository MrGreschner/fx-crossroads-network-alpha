config_version=5

[application]
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03137,0.10588,0.14902,1)
config/name="Crossroads: Realms Beyond"
config/version="233"
config/icon="res://assets/crossroads_emblem.svg"
; Keep the established desktop save location for existing players.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/FX Crossroads"
config/custom_user_dir_name.windows="Godot/app_userdata/FX Crossroads"
config/custom_user_dir_name.macos="Godot/app_userdata/FX Crossroads"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[input_devices]
pointing/emulate_mouse_from_touch=true

[autoload]

FXCommunityHeroes="*res://scripts/community_heroes.gd"
FXAccount="*res://scripts/cloud_account.gd"
FXClassPro="*res://scripts/class_pro.gd"
FXProgressGuide="*res://scripts/progression_guide.gd"
FXActivity="*res://scripts/activity_analytics.gd"
FXStudioPartner="*res://scripts/studio_partner.gd"
FXEducationRoom="*res://scripts/education_room.gd"
FXEducationTools="*res://scripts/education_tools.gd"
FXResearch="*res://scripts/research_session.gd"
FXClassroom="*res://scripts/classroom_broadcast.gd"
FXDevSession="*res://scripts/dev_session.gd"
FXStability="*res://scripts/stability.gd"

[debug]
file_logging/enable_file_logging=true
file_logging/max_log_files=3
file_logging/log_path="user://logs/godot.log"

[editor_plugins]
enabled=PackedStringArray("res://addons/browser_files/plugin.cfg")
