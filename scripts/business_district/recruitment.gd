extends RefCounted
const DOMAINS=["kitchen","clothier","workshop","fishery","garden","mine","store","courier","rental","salon","daycare","minigolf","dessert","cafe"]
const JOBS={"kitchen":["Bakery preparation assistant","Lunch counter cook","Café shift assistant"],"clothier":["Alterations assistant","Weaving apprentice","Outfitter stock assistant"],"workshop":["Repair bench apprentice","Furniture maker assistant","Clockwork assembly assistant"],"fishery":["Fish counter assistant","Cold-store receiver","Smokehouse assistant"],"garden":["Nursery assistant","Orchard harvest worker","Florist assistant"],"mine":["Foundry apprentice","Stone finishing assistant","Ore sorting assistant"],"store":["General shop sales assistant","Market stall cashier","Merchandising assistant"],"courier":["Parcel sorting assistant","Cycle delivery rider","Dispatch assistant"],"rental":["Equipment inspection assistant","Hire desk assistant","Tool maintenance assistant"]}
const NEW_JOBS={"salon":["Salon assistant","Barber apprentice","Colour studio assistant"],"daycare":["Dog daycare attendant","Kennel care assistant","Dog walking assistant"],"minigolf":["Mini-golf course host","Recreation attendant","Putting coach assistant"],"dessert":["Bakery assistant","Dessert counter assistant","Ice cream shop assistant"],"cafe":["Coffee shop barista","Tea counter assistant","Bubble tea preparation assistant"]}
static func pool(epoch:int,seed_value:int,exclude:Array=[])->Array:
 var rng=RandomNumberGenerator.new();rng.seed=seed_value+epoch*47291
 var first=["Mira","Bram","Nell","Tavi","Orin","Sable","Pip","Ada","Lio","Fenna","Jory","Mael","Nia","Perrin","Cora","Enzo","Iona","Rafi","Willa","Teo","Anika","Oren","Zara","Callum","Veda","Emil","Isla","Kian","Maren","Tomas","Lena","Dara","Yara","Alden","Faye","Ronan","Eli","Mina","Jules","Sora"]
 var last=["Reed","Ashcroft","Moss","Bell","Stone","Vale","Thorne","Brook","Flint","Wren","Sage","Rowan","Wick","Marsh","Cedar","Hart","Fern","Silver","Pike","Bracken","Lark","Hollow","Willow","Clove","Finch","Elm","Gale","Frost","Copper","Dawn"]
 var result=[];var names=[]
 for i in 30:
  var name=first[rng.randi_range(0,first.size()-1)]+" "+last[rng.randi_range(0,last.size()-1)]
  while name in names or name in exclude:name=first[rng.randi_range(0,first.size()-1)]+" "+last[rng.randi_range(0,last.size()-1)]
  names.append(name)
  var domain=DOMAINS[(i+epoch)%DOMAINS.size()];var second=DOMAINS[rng.randi_range(0,DOMAINS.size()-1)];var years=rng.randi_range(1,4);var ago=rng.randi_range(0,4);var prior_years=rng.randi_range(1,2);var skills={}
  for d in DOMAINS:skills[d]=rng.randf_range(.55,.85)
  skills[domain]=clampf(.9+years*.12-ago*.025+rng.randf_range(-.04,.04),.85,1.5);skills[second]=maxf(skills[second],.8+prior_years*.1-(years+ago)*.015)
  if domain in ["kitchen","dessert","cafe"]:
   for food in ["kitchen","dessert","cafe"]:skills[food]=maxf(skills[food],skills[domain]*.82)
  var service=clampf((.95 if domain in ["store","courier","rental","kitchen"] else .65)+years*.08-ago*.02+rng.randf_range(-.08,.08),.6,1.5);var reliability=rng.randf_range(.85,1.0);var logistics=clampf((.9 if domain in ["courier","fishery","garden","mine"] else .7)+years*.08-ago*.015,.65,1.5)
  result.append({"id":100+epoch*100+i,"name":name,"species":["ram","badger","cat","newt","human","fox","hare","owl"][rng.randi_range(0,7)],"coat":Color.from_hsv(rng.randf(),.25,.60).to_html(false),"skin":Color.from_hsv(rng.randf(),.18,.86).to_html(false),"wage":snappedf(14+(skills[domain]-.5)*8+service*5,.5),"service":service,"logistics":logistics,"reliability":reliability,"craft":skills[domain],"skills":skills,"experience":[{"job":(NEW_JOBS.get(domain,JOBS.get(domain,[])))[rng.randi_range(0,2)],"years":years,"ago":ago,"domain":domain},{"job":(NEW_JOBS.get(second,JOBS.get(second,[])))[rng.randi_range(0,2)],"years":prior_years,"ago":years+ago,"domain":second}],"bio":["Enjoys patient, detailed work.","Likes busy teams and learning new routines.","Prefers organised supplies and clear handovers.","Enjoys explaining products to customers.","Likes improving a process after trying it."][rng.randi_range(0,4)],"reference":["Reference: handled a busy counter calmly.","Reference: accurate receiving and stock counts.","Reference: careful finishing and product checks.","Reference: dependable handovers and attendance."][rng.randi_range(0,3)]})
 return result
