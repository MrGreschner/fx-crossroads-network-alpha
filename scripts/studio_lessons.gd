extends RefCounted
static func design()->Array:
 return optional_tasks([
 {"title":"Shape & readability","summary":"A great hero is recognisable at game size, before we read their name.","body":"SILHOUETTE • Make the body, head and important equipment distinct.\nEMPHASIS • Choose one focal point that hints at the hero’s role.\nCONTRAST • Separate face, hands and weapon from the body. Readability matters more than tiny detail.","task":"Shrink your drawing to its in-game size. Ask a partner what creature, object and role they see without telling them."},
 {"title":"Colour & unity","summary":"A small, deliberate palette helps the whole pose set feel connected.","body":"COLOUR • Start with a body colour, shadow, highlight and one accent. Use the hex field to repeat exact colours.\nUNITY • Keep outline thickness and key shapes consistent.\nACCESSIBILITY • Communicate with shape and motion as well as colour.","task":"Check your art against a dark background and a light one. Can you still identify the face and attack direction?"},
 {"title":"Motion & rhythm","summary":"Small changes between poses can create convincing movement.","body":"BALANCE • Keep the feet or contact point aligned.\nRHYTHM • Keep head/torso neutral and front-facing. Use an 80 × 80 transparent hero canvas; copy idle into Walk 1 and Walk 2, then move opposite feet, paws, wings or floating details by 1–2 pixels.\nANTICIPATION • Let the attack pose show a wind-up. Your animation should explain where the damage happens.","task":"Use the live walking preview. If the hero jumps instead of walking, compare the face and ground contact points."},
 {"title":"Balance & iteration","summary":"An interesting hero has strengths, limits and choices.","body":"Give powerful effects a readable warning, cooldown, limited range or a commitment such as charging. Mastery alternatives should create a different play style instead of a strict upgrade.\nChange one variable per test so you can explain what caused the result.","task":"Write a prediction, test it, then compare your evidence with that prediction. Ask a partner whether the attack feels fair."}])
static func code()->Array:
 return optional_tasks([
 {"title":"Variables","summary":"A named value lets you change an attack without rewriting its structure.","body":"let damage = 18\nlet count = 3\n\nThe number controls the value. Changing the GUI updates the declaration; changing the declaration updates the GUI after validation.","task":"Predict what doubling count will do. Replay before and after, then compare the results."},
 {"title":"Loops & logic","summary":"Repeat an action, or choose when it should happen.","body":"repeat count\n  emit projectile angle index * 12 - 12\nend\n\nindex changes each repetition.\n\nif charged\n  emit pulse\nend\n\ncharged means at least 75% charge. if targets checks for living targets.\n\nUse elif targets for another branch, else for a fallback. for index in count is also a loop. Advanced code Level 2 shows methods and physics; Level 3 shows runtime classes and references.","task":"Change the angle expression to index * 20 - 20. What happens to the fan’s coverage?"},
 {"title":"Data & structure","summary":"A hero is a dictionary; animation frames are an ordered array.","body":"Declarations come first, followed by action blocks. Each repeat or if needs end.\nA saved ability combines values, a program and animation frames. A hero project combines artwork, abilities, mastery choices and test reports.","task":"Draw a simple diagram of one hero project. Which values are numbers, strings, dictionaries and arrays?"},
 {"title":"Testing & limits","summary":"Code should make a clear prediction that you can check.","body":"The Lab validates names, ranges and matching blocks before running. Invalid edits are not applied to the replay. Casts are capped at 32 actions.\nCrossroads Script is a restricted learning language. It cannot access files, networking or the operating system.","task":"Remove one end, read the validation message, and fix the program. Then document a successful controlled test."}])

static func optional_tasks(cards:Array)->Array:
 if not preload("res://scripts/education_access.gd").student():
  for card in cards:card.erase("task")
 return cards
