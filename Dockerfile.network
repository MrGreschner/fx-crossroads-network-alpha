FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip libfontconfig1 libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 libgl1 libasound2 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/godotengine/godot/releases/download/4.5.1-stable/Godot_v4.5.1-stable_linux.x86_64.zip -o /tmp/godot.zip \
 && echo '02ec53d1cc7dbb9cc6355393c61b9ab43d1244751a124f10248a4802830788cd  /tmp/godot.zip' | sha256sum -c - \
 && unzip -q /tmp/godot.zip -d /tmp \
 && mv /tmp/Godot_v4.5.1-stable_linux.x86_64 /usr/local/bin/godot && chmod +x /usr/local/bin/godot && rm /tmp/godot.zip
WORKDIR /app
COPY . /app
RUN godot --headless --editor --path /app --quit
WORKDIR /app/network_service
RUN npm ci --omit=dev
ENV GODOT_BIN=/usr/local/bin/godot FX_PROJECT_ROOT=/app PORT=9080 FX_GAME_PORT=9081
EXPOSE 9080
USER node
CMD ["npm", "start"]
